{
  "name": "vite-digital",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tray": "wscript.exe run-tray.vbs",
    "stop": "cmd /c stop-tray.bat",
    "electron": "electron electron/main.cjs",
    "electron:dev": "concurrently -k -r -s first \"npm run dev\" \"wait-on -t 30000 tcp:5173 && electron electron/main.cjs\"",
    "electron:prod": "npm run build && electron electron/main.cjs --prod",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/vue-fontawesome": "^3.0.8",
    "axios": "^1.7.3",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.4.8",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "git": "^0.1.5",
    "html2pdf.js": "^0.14.0",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "moment": "^2.30.1",
    "pinia": "^3.0.4",
    "sweetalert2": "^11.26.4",
    "thai-baht-text": "^2.0.5",
    "vue": "^3.4.35",
    "vue-chartjs": "^5.3.2",
    "vue-router": "^4.4.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.8.0",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vue/eslint-config-prettier": "^9.0.0",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "prettier": "^3.2.5",
    "vite": "^5.4.0",
    "wait-on": "^9.5.1"
  }
}
